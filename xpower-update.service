[Unit]
Description=XPowerSpirit Daily Update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=XPOWER_CONFIG_DIR=/etc/xpower
Environment=XPOWER_INSTALL_DIR=/opt/xpower
ExecStart=/opt/xpower/update-xray-linux.sh

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xpower-update

# Безопасность
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# ВАЖНО: при ProtectSystem=strict FS доступен только для чтения,
# поэтому все пути, куда пишет update-скрипт, должны быть перечислены:
#   /usr/local/bin/xray — самобинарник Xray
#   /run/lock            — flock-файл блокировки
#   /etc/xpower/state    — сохранённые SHA256
#   /var/log,/var/cache  — лог и временные файлы
#   geo-файлы и config.json — обновляются по месту
ReadWritePaths=/usr/local/bin/xray /run/lock /etc/xpower/state /etc/xpower/config.json /var/log/xpower /var/cache/xpower /opt/xpower/geoip.dat /opt/xpower/geosite.dat
ReadOnlyPaths=/etc/xpower/settings.json
