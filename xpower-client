#!/bin/bash
# XPowerSpirit CLI — управление Xray TProxy клиентом
#
# Использование:
#   xpower-client status       Показать статус
#   xpower-client start        Запустить прокси
#   xpower-client stop         Остановить прокси
#   xpower-client restart      Перезапустить
#   xpower-client update       Обновить подписку и конфиг
#   xpower-client toggle       Вкл/выкл
#   xpower-client test         Проверить соединение
#   xpower-client logs         Логи (journalctl)
#   xpower-client config       Показать конфигурацию
#   xpower-client proxy-list   Список прокси-серверов

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

CONFIG_DIR="${XPOWER_CONFIG_DIR:-/etc/xpower}"
CONFIG_JSON="${CONFIG_DIR}/config.json"
# Состояние подписки (режим + причина DIRECT-режима) — пишет генератор конфига
STATUS_JSON="${CONFIG_DIR}/state/status.json"

usage() {
    cat <<EOF
XPowerSpirit Client — управление Xray TProxy

Использование:
  xpower-client status       Показать статус (включая трафик и активные ноды)
  xpower-client start        Запустить прокси
  xpower-client stop         Остановить прокси
  xpower-client restart      Перезапустить
  xpower-client update       Обновить подписку и конфиг
  xpower-client toggle       Вкл/выкл прокси
  xpower-client test         Проверить соединение
  xpower-client traffic      Статистика трафика по серверам
  xpower-client logs         Логи в реальном времени
  xpower-client config       Показать конфигурацию
  xpower-client proxy-list   Список прокси-серверов
  xpower-client setup        Переустановить nftables правила
EOF
}

# Порт локального DNS-инбаунда Xray (dns-local) — из config.json,
# т.к. установщик может выбрать 5353 (resolved/dnsmasq) или 53 (resolv.conf)
dns_local_port() {
    python3 -c "
import json
try:
    with open('$CONFIG_JSON') as f:
        cfg = json.load(f)
    for ib in cfg.get('inbounds', []):
        if ib.get('tag') == 'dns-local':
            print(ib.get('port', 5353))
            break
    else:
        print(5353)
except Exception:
    print(5353)
" 2>/dev/null || echo 5353
}

# Порт TProxy-инбаунда — из config.json (задаётся в settings.json → tproxy.port)
tproxy_port() {
    python3 -c "
import json
try:
    with open('$CONFIG_JSON') as f:
        cfg = json.load(f)
    for ib in cfg.get('inbounds', []):
        if ib.get('tag') == 'tproxy-in':
            print(ib.get('port', 12345))
            break
    else:
        print(12345)
except Exception:
    print(12345)
" 2>/dev/null || echo 12345
}

# Порт API Xray (statsquery) — из config.json (settings.json → api.listen_port)
api_port() {
    python3 -c "
import json
try:
    with open('$CONFIG_JSON') as f:
        listen = str(json.load(f).get('api', {}).get('listen', ''))
    print(listen.rsplit(':', 1)[-1] or 10085)
except Exception:
    print(10085)
" 2>/dev/null || echo 10085
}

# Человекочитаемый размер (Б/КБ/МБ/ГБ/ТБ)
human_bytes() {
    awk -v b="${1:-0}" 'BEGIN {
        split("B KB MB GB TB", u, " ");
        i = 1;
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf (i == 1 ? "%.0f %s" : "%.1f %s"), b, u[i];
    }'
}

# Статистика трафика из Xray API (statsquery).
# Печатает строки: "TOTAL <up> <down>", "COUNT <n>", "NODE <tag> <up> <down>".
# Возвращает 1, если Xray не запущен, API отключён или данных нет.
traffic_stats() {
    [ -x /usr/local/bin/xray ] || return 1

    local raw
    raw="$(/usr/local/bin/xray api statsquery --server="127.0.0.1:$(api_port)" -pattern "" 2>/dev/null)" || return 1
    [ -n "$raw" ] || return 1

    printf '%s' "$raw" | python3 -c '
import json, re, sys

raw = sys.stdin.read()
pairs = []

try:
    data = json.loads(raw)
except Exception:
    data = None

if isinstance(data, dict):
    items = data.get("stat") or []
elif isinstance(data, list):
    items = data
else:
    items = []

for st in items:
    if isinstance(st, dict):
        pairs.append((str(st.get("name", "")), int(st.get("value", 0) or 0)))

# Фолбэк для текстового (protobuf) вывода: stat: < name: "..." value: N >
if not pairs:
    for chunk in raw.split("name:"):
        if "value:" not in chunk:
            continue
        quoted = chunk.split(chr(34))
        vm = re.search(r"value:\s*(\d+)", chunk)
        if len(quoted) > 1 and vm:
            pairs.append((quoted[1], int(vm.group(1))))

if not pairs:
    sys.exit(1)

total_up = 0
total_down = 0
nodes = {}

for name, value in pairs:
    parts = name.split(">>>")
    if len(parts) != 4 or parts[2] != "traffic":
        continue
    kind, tag, _, direction = parts
    if kind not in ("inbound", "outbound"):
        continue
    if direction == "uplink":
        total_up += value
    else:
        total_down += value
    # служебные теги не показываем как «ноды»
    if tag in ("api", "direct", "block", "dns-out", "dns-local",
               "socks-in", "http-in", "tproxy-in", "balancer"):
        continue
    node = nodes.setdefault(tag, {"up": 0, "down": 0})
    if direction == "uplink":
        node["up"] += value
    else:
        node["down"] += value

print("TOTAL %d %d" % (total_up, total_down))
ranked = sorted(nodes.items(), key=lambda kv: kv[1]["up"] + kv[1]["down"], reverse=True)
print("COUNT %d" % len(ranked))
for tag, val in ranked:
    print("NODE %s %d %d" % (tag, val["up"], val["down"]))
' 2>/dev/null
}

# Проверка DNS через локальный инбаунд Xray.
# dig/nslookup в дистрибутив не входят и могут отсутствовать,
# а у BIND9-овского nslookup опции должны идти ПЕРЕД именем и сервером.
# Поэтому есть фолбэк на getent — он проверяет системный резолвер,
# который тоже смотрит в Xray.
dns_check() {
    local port="$1"
    local name="example.com"

    if command -v dig >/dev/null 2>&1; then
        dig +short +time=3 +tries=1 @127.0.0.1 -p "$port" "$name" >/dev/null 2>&1 && return 0
    elif command -v nslookup >/dev/null 2>&1; then
        nslookup -port="${port}" "$name" 127.0.0.1 >/dev/null 2>&1 && return 0
    fi

    getent ahostsv4 "$name" >/dev/null 2>&1
}

do_status() {
    echo ""
    echo -e "${CYAN}=== XPowerSpirit Status ===${NC}"
    echo ""

    # Сервис
    echo -n "  Сервис:           "
    if systemctl is-active --quiet xpower-client 2>/dev/null; then
        echo -e "${GREEN}● активен${NC}"
    else
        echo -e "${RED}○ остановлен${NC}"
    fi

    # Автообновление
    echo -n "  Автообновление:   "
    if systemctl is-active --quiet xpower-update.timer 2>/dev/null; then
        NEXT=$(systemctl list-timers xpower-update.timer --no-legend 2>/dev/null | awk '{print $3" "$4" "$5" "$6}')
        echo -e "${GREEN}● включено${NC} (след.: ${NEXT:-N/A})"
    else
        echo -e "${YELLOW}○ отключено${NC}"
    fi

    # Xray
    echo -n "  Xray Core:        "
    if /usr/local/bin/xray version >/dev/null 2>&1; then
        VER=$(/usr/local/bin/xray version 2>/dev/null | head -1 | awk '{print $2}')
        echo -e "${GREEN}$VER${NC}"
    else
        echo -e "${RED}не установлен${NC}"
    fi

    # nftables (требует root)
    echo -n "  nftables:         "
    if sudo nft list table inet xpower >/dev/null 2>&1; then
        RULE_COUNT=$(sudo nft list table inet xpower 2>/dev/null | grep -c '^\s')
        echo -e "${GREEN}● настроены${NC} (правил: $RULE_COUNT)"
    else
        echo -e "${RED}○ не настроены${NC}"
    fi

    # Policy routing
    echo -n "  Policy routing:   "
    if ip rule show 2>/dev/null | grep -q 'fwmark 0x1 lookup 100'; then
        echo -e "${GREEN}● настроен${NC}"
    else
        echo -e "${RED}○ не настроен${NC}"
    fi

    # Config
    echo -n "  config.json:      "
    if [ -f "$CONFIG_JSON" ]; then
        echo -e "${GREEN}● существует${NC} ($(stat -c%s "$CONFIG_JSON" 2>/dev/null || echo '?') байт)"
    else
        echo -e "${RED}○ отсутствует${NC}"
    fi

    # Состояние подписки: режим и причина DIRECT-режима (пишет генератор)
    echo -n "  Подписка:         "
    if [ -f "$STATUS_JSON" ]; then
        local line mode text
        line=$(python3 -c "
import json
try:
    with open('$STATUS_JSON') as f:
        s = json.load(f)
    mode = str(s.get('mode', '?'))
    updated = str(s.get('updated', ''))
    when = (' (обновлено ' + updated[11:16] + ')') if len(updated) >= 16 else ''
    if mode == 'direct':
        text = 'DIRECT-режим — ' + (str(s.get('reason') or '') or 'причина неизвестна') + when
    else:
        text = 'прокси-режим, серверов: ' + str(s.get('servers', 0)) + when
    print(mode + chr(9) + text)
except Exception:
    print('?' + chr(9) + 'нет данных')
" 2>/dev/null)
        IFS=$'\t' read -r mode text <<< "$line"
        if [ "$mode" = "direct" ]; then
            echo -e "${YELLOW}○ ${text}${NC}"
        elif [ "$mode" = "proxy" ]; then
            echo -e "${GREEN}● ${text}${NC}"
        else
            echo -e "${YELLOW}○ ${text}${NC}"
        fi
    else
        echo -e "${YELLOW}○ нет данных${NC} (запустите: xpower-client update)"
    fi

    # Трафик и активные ноды (через API Xray)
    echo "  Трафик:"
    local stats
    if stats="$(traffic_stats)"; then
        local up down
        up=$(echo "$stats" | awk '/^TOTAL/ {print $2}')
        down=$(echo "$stats" | awk '/^TOTAL/ {print $3}')
        echo "    Всего:            ↑ $(human_bytes "$up")  ↓ $(human_bytes "$down")"
        local nodes
        nodes=$(echo "$stats" | awk '/^NODE/ {print}' | head -5)
        if [ -n "$nodes" ]; then
            echo "    Активные ноды:"
            while read -r _ tag nup ndown; do
                [ -n "$tag" ] || continue
                printf "      ${GREEN}●${NC} %-16s ↑ %s  ↓ %s\n" "$tag" "$(human_bytes "$nup")" "$(human_bytes "$ndown")"
            done <<< "$nodes"
        else
            echo "    Активные ноды:    (трафика пока нет)"
        fi
    else
        echo "    Всего:            ${YELLOW}○ нет данных${NC} (Xray не запущен или api.enabled=false)"
    fi

    # Прокси
    echo "  Прокси-серверы:"
    if [ -f "$CONFIG_JSON" ]; then
        python3 -c "
import json
with open('$CONFIG_JSON') as f:
    cfg = json.load(f)
outbounds = [o for o in cfg.get('outbounds', []) if o.get('protocol') == 'vless']
if outbounds:
    for o in outbounds:
        tag = o.get('tag', '?')
        vnext = o.get('settings', {}).get('vnext', [{}])[0]
        addr = vnext.get('address', '?')
        port = vnext.get('port', '?')
        net = o.get('streamSettings', {}).get('network', '?')
        sec = o.get('streamSettings', {}).get('security', 'none')
        print(f'    {tag}: {addr}:{port} ({net}/{sec})')
else:
    print('    (нет прокси — DIRECT режим)')
" 2>/dev/null || echo "    (ошибка чтения конфига)"
    else
        echo "    (config.json не найден)"
    fi

    echo ""
}

do_test() {
    echo ""
    echo -e "${CYAN}=== Проверка соединения ===${NC}"
    echo ""
    # Базовое интернет-соединение
    echo -n "  Интернет:         "
    if curl -fs --max-time 5 https://ifconfig.me/ip -o /dev/null 2>/dev/null; then
        IP=$(curl -s --max-time 5 https://ifconfig.me/ip)
        echo -e "${GREEN}● $IP${NC}"
    else
        echo -e "${RED}○ нет соединения${NC}"
    fi

    # DNS через Xray
    DNS_PORT="$(dns_local_port)"
    echo -n "  DNS (Xray :${DNS_PORT}): "
    if dns_check "$DNS_PORT"; then
        echo -e "${GREEN}● OK${NC}"
    else
        echo -e "${YELLOW}○ не отвечает${NC}"
    fi

    # Google connectivity check (тест прокси)
    echo -n "  Google:           "
    # `|| true` + проверка на пустоту: иначе при сбое curl к его «000»
    # добавлялся ещё и echo «000» из ||, получалось «HTTP 000000»
    STATUS=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' http://connectivitycheck.gstatic.com/generate_204 2>/dev/null || true)
    [ -n "$STATUS" ] || STATUS="000"
    if [ "$STATUS" = "204" ]; then
        echo -e "${GREEN}● OK (HTTP $STATUS)${NC}"
    else
        echo -e "${YELLOW}○ HTTP $STATUS${NC}"
    fi

    # Проверка что трафик идёт через прокси
    TPROXY_PORT="$(tproxy_port)"
    echo -n "  Маршрутизация:    "
    if ss -tlnp 2>/dev/null | grep -q ":${TPROXY_PORT}"; then
        echo -e "${GREEN}● TProxy слушает (:${TPROXY_PORT})${NC}"
    else
        echo -e "${RED}○ TProxy не слушает (:${TPROXY_PORT})${NC}"
    fi

    echo ""
}

do_config() {
    if [ -f "$CONFIG_JSON" ]; then
        python3 -m json.tool "$CONFIG_JSON" 2>/dev/null | head -100
        TOTAL=$(wc -l < "$CONFIG_JSON")
        if [ "$TOTAL" -gt 100 ]; then
            echo "... (ещё $((TOTAL - 100)) строк)"
        fi
    else
        echo "config.json не найден: $CONFIG_JSON"
    fi
}

do_proxy_list() {
    python3 -c "
import json
with open('$CONFIG_JSON') as f:
    cfg = json.load(f)
outbounds = [o for o in cfg.get('outbounds', []) if o.get('protocol') == 'vless']
print(f'Прокси-серверов: {len(outbounds)}')
for o in outbounds:
    tag = o.get('tag', '?')
    vnext = o.get('settings', {}).get('vnext', [{}])[0]
    addr = vnext.get('address', '?')
    port = vnext.get('port', '?')
    user = vnext.get('users', [{}])[0]
    uid = user.get('id', '?')
    flow = user.get('flow', '')
    net = o.get('streamSettings', {}).get('network', '?')
    sec = o.get('streamSettings', {}).get('security', 'none')
    print(f'  [{tag}]')
    print(f'    Адрес:     {addr}:{port}')
    print(f'    Сеть:      {net}')
    print(f'    TLS:       {sec}')
    print(f'    UUID:      {uid}')
    if flow:
        print(f'    Flow:      {flow}')
    print()
" 2>/dev/null
}

# Подробная статистика трафика (все ноды, а не только топ-5 как в status)
do_traffic() {
    echo ""
    echo -e "${CYAN}=== Трафик XPowerSpirit ===${NC}"
    echo ""

    local stats
    if ! stats="$(traffic_stats)"; then
        echo "  нет данных: Xray не запущен или API отключён"
        echo "  (проверьте: systemctl status xpower-client; settings.json → api.enabled)"
        echo ""
        # код возврата 1 — чтобы `xpower-client traffic || ...` работал в скриптах
        return 1
    fi

    local up down
    up=$(echo "$stats" | awk '/^TOTAL/ {print $2}')
    down=$(echo "$stats" | awk '/^TOTAL/ {print $3}')
    printf "  Всего:  ↑ %s  ↓ %s\n" "$(human_bytes "$up")" "$(human_bytes "$down")"
    echo ""

    local nodes
    nodes=$(echo "$stats" | awk '/^NODE/ {print}')
    if [ -z "$nodes" ]; then
        echo "  трафика через серверы пока не было"
    else
        printf "  %-18s %12s %12s\n" "сервер" "отдано" "принято"
        while read -r _ tag nup ndown; do
            [ -n "$tag" ] || continue
            printf "  %-18s %12s %12s\n" "$tag" "$(human_bytes "$nup")" "$(human_bytes "$ndown")"
        done <<< "$nodes"
    fi
    echo ""
}

case "${1:-}" in
    status)     do_status ;;
    start)      sudo systemctl start xpower-client && echo "XPowerSpirit запущен" ;;
    stop)       sudo systemctl stop xpower-client && echo "XPowerSpirit остановлен" ;;
    restart)    sudo systemctl restart xpower-client && echo "XPowerSpirit перезапущен" ;;
    update)     sudo /opt/xpower/update-xray-linux.sh ;;
    toggle)
        if systemctl is-active --quiet xpower-client 2>/dev/null; then
            sudo systemctl stop xpower-client
            echo -e "${YELLOW}XPowerSpirit остановлен${NC}"
        else
            sudo systemctl start xpower-client
            echo -e "${GREEN}XPowerSpirit запущен${NC}"
        fi ;;
    test)       do_test ;;
    traffic)    do_traffic ;;
    logs)       sudo journalctl -u xpower-client -f ;;
    config)     do_config ;;
    proxy-list) do_proxy_list ;;
    setup)      sudo /opt/xpower/update-nft-linux.sh ;;
    -h|--help)  usage ;;
    *)
        echo "Неизвестная команда: $1"
        echo ""
        usage
        exit 1
        ;;
esac
