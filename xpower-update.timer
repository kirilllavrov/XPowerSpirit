[Unit]
Description=XPowerSpirit Daily Update Timer

[Timer]
# Явный Unit= вместо Requires=: иначе `systemctl start` таймера сразу же
# запускал бы сервис обновления (обновление прямо во время установки)
Unit=xpower-update.service
# Ежедневно в случайное время (с разбросом 30 мин)
OnCalendar=daily
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
