[Unit]
Description=XPowerSpirit Daily Update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=XPOWER_CONFIG_DIR=/etc/xpower
Environment=XPOWER_INSTALL_DIR=/opt/xpower
ExecStart=/opt/xpower/update-xray.sh

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xpower-update

# Безопасность
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/xpower /var/cache/xpower /opt/xpower/geoip.dat /opt/xpower/geosite.dat /etc/xpower/state /etc/xpower/config.json
ReadOnlyPaths=/etc/xpower/settings.json
